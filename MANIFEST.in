include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include pyproject.toml

include flowforge/py.typed
include flowforge/mkdocs.yml

recursive-include .github/workflows *.yml
recursive-include flowforge/_docs *.md
recursive-include flowforge/skills/anthropic *
recursive-include flowforge/tools/_ppt_master *.md LICENSE

recursive-include examples *.py
recursive-include tests *.py

prune .flowforge_cache
prune _artifacts
prune examples/_artifacts
prune build
prune dist
prune flowforge.egg-info
prune flowforge/site
